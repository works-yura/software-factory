<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ and writes it to ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.eclipt.factory</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/.mastracode/factory-v4/start-server.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart on a failed exit (crash, watchdog); a clean stop (launchctl bootout) stays stopped. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/factory.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/factory.log</string>
</dict>
</plist>
