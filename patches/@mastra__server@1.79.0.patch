+const MAX_WIRE_RESPONSE_BODY_LENGTH = 2e3;
+/** Keeps what core saves on an error part, so a live error reads the same as a reloaded one. Factory patch, from upstream #27811. */
+function toWireError(error) {
+	const wire = {
+		name: error.name,
+		message: error.message
+	};
+	try {
+		const { statusCode, responseBody, responseHeaders, requestBodyValues } = error;
+		if (typeof statusCode === "number" && Number.isInteger(statusCode)) wire.statusCode = statusCode;
+		if (typeof responseBody === "string" && responseBody.trim()) wire.responseBody = responseBody.length > MAX_WIRE_RESPONSE_BODY_LENGTH ? `${responseBody.slice(0, MAX_WIRE_RESPONSE_BODY_LENGTH)}…` : responseBody;
+		const requestId = responseHeaders?.["request-id"] ?? responseHeaders?.["x-request-id"];
+		if (typeof requestId === "string" && requestId.trim()) wire.requestId = requestId.trim();
+		const modelId = requestBodyValues?.model;
+		if (typeof modelId === "string" && modelId.trim()) wire.modelId = modelId.trim();
+	} catch {}
+	return wire;
+}
