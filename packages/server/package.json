    "@factory/feed": "workspace:*",
    "@factory/harness": "workspace:*",
    "@factory/harness-claude-code": "workspace:*",
    "@factory/harness-claude-code-ui": "workspace:*",
    "@factory/harness-mastra": "workspace:*",
    "@factory/http": "workspace:*",
    "@factory/integration-github": "workspace:*",
    "@factory/integration-gitlab": "workspace:*",
    "@factory/integrations": "workspace:*",
