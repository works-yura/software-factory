{
  "name": "@factory/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MastraFactory: assembles runtime, storage, harness, integrations (GitHub, GitLab), API, and Supervisor; holds the cross-layer system tests.",
