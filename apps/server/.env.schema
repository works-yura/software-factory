# MastraCode Web environment schema for Varlock.
# Every section is optional: when the vars for a feature are absent, that
# feature is a no-op and the web app behaves exactly as before.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Sandbox commands always run on this machine (the local sandbox), as the
# server's OS user, without isolation. Outside development the server refuses
# to start until this is set to local, confirming that choice. Any other value
# is rejected.
# @public @type=enum("", "local")
FACTORY_SANDBOX_PROVIDER=

# Browser automation tools for agent sessions. Unset (the default) gives
# agents no browser. agent-browser runs headless Chromium on this server host,
# not in the session sandbox, so agents can reach whatever this host can.
# Needs a Chromium the agent-browser package can launch.
# @public @type=enum("", "agent-browser")
FACTORY_BROWSER=

# ---------------------------------------------------------------------------
# Browser-facing origin
# ---------------------------------------------------------------------------

# The public origin the browser uses to reach the app. This is the single
# source of truth for ALL OAuth callback URLs:
#   - SSO auth providers:  <MASTRACODE_PUBLIC_URL>/auth/callback
#   - Google sign-in (FACTORY_AUTH=google):  <MASTRACODE_PUBLIC_URL>/auth/api/callback/google
#   - GitHub:  <MASTRACODE_PUBLIC_URL>/auth/github/callback
# Defaults to http://localhost:4111 (the Factory server, which also serves
# the UI) when unset. When developing with a separate Vite dev server (:5173
# proxying to the API on :4111), set this to the SPA origin
# (http://localhost:5173). Restart the dev server after changing this —
# varlock re-reads .env on each start.
# @public @type=url
MASTRACODE_PUBLIC_URL=
# Public origin Slack/channels must reach for OAuth callbacks and deep links.
# Must be publicly routable (e.g. a tunnel). Kept separate from
# MASTRACODE_PUBLIC_URL so auth can run on localhost (the hosted platform only
# allow-lists localhost for the auth redirect) while Slack still reaches this
# machine via the tunnel. Falls back to MASTRACODE_PUBLIC_URL when unset.
# @public @type=url
MASTRACODE_CHANNELS_PUBLIC_URL=
# Slack request signing secret (Basic Information → App Credentials). This is
# the switch for Slack as a whole: unset → no Slack integration is constructed
# and the Connections page reports Slack as not set up. Also the last-resort
# state-signer secret (see GITHUB_APP_WEBHOOK_SECRET below), so a Slack-only
# deployment has a signer that survives a restart.
# @sensitive
SLACK_APP_SIGNING_SECRET=
# Slack bot token (OAuth & Permissions → Bot User OAuth Token, starts xoxb-).
# Lets the app post messages and open DMs; without it Slack can reach the app
# but the app cannot answer.
# @sensitive
SLACK_APP_BOT_TOKEN=
# Slack app OAuth client credentials (Basic Information → App Credentials).
# Enable the web-initiated "Sign in with Slack" (OIDC) account-linking flow;
# unset → linking only starts from the Slack-side Connect card. The Slack app
# must list MASTRACODE_CHANNELS_PUBLIC_URL + /connect/slack/oidc/callback as an
# OAuth redirect URL (Slack requires HTTPS, so locally that's the tunnel).
# @public
SLACK_APP_CLIENT_ID=
# @sensitive
SLACK_APP_CLIENT_SECRET=
# Comma-separated origins allowed for credentialed cross-origin requests; only
# needed when the SPA is hosted separately from the API server.
# @public
MASTRACODE_ALLOWED_ORIGINS=
# Explicit path to the built SPA (a dir containing index.html). In production
# the built SPA is served same-origin at `/` by the API server. It is
# auto-located: MASTRACODE_UI_DIST, then `ui/` next to the server bundle
# (mastra build copies the vite output there via the Mastra entry's public/
# dir), then `src/mastra/public/ui` under cwd.
# @public
MASTRACODE_UI_DIST=

# ---------------------------------------------------------------------------
# Stored credential encryption
# ---------------------------------------------------------------------------

# Required whenever authentication is enabled. Base64-encoded 32-byte AES key
# used to encrypt model-provider keys, custom-provider API keys, GitHub PATs,
# and integration OAuth tokens before they are persisted. Generate with:
#   openssl rand -base64 32
# Keep this stable across deploys; losing it makes stored credentials unreadable.
# Outside development the server refuses to start without it, unless
# FACTORY_CREDENTIAL_ENCRYPTION=plaintext is set.
# @sensitive
FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Set to plaintext to start without FACTORY_CREDENTIAL_ENCRYPTION_KEY outside
# development and store credentials unencrypted. Not recommended.
# @public
FACTORY_CREDENTIAL_ENCRYPTION=
# Identifier recorded with new ciphertext. Change this when rotating the key.
# @public
FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=v1
# Optional JSON object mapping previous key ids to base64-encoded 32-byte keys.
# Keep old keys here during rotation; rows are re-encrypted with the primary key
# when read or when storage initializes. Example: {"v1":"<old-base64-key>"}
# @sensitive
FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------

# Directory for card and session attachment files (content-addressed by sha256).
# Unset: `factory-attachments` next to the local database. Must be absolute.
# @public
FACTORY_ATTACHMENTS_DIR=

# Per-file attachment limit in bytes. Unset: 52428800 (50 MiB).
# @public
FACTORY_ATTACHMENTS_MAX_BYTES=

# ---------------------------------------------------------------------------
# Deployment-provided model providers
# ---------------------------------------------------------------------------

# Comma-separated model providers that every signed-in account may run on this
# server's own credentials. Supported: amazon-bedrock (also set AWS_REGION and
# either AWS_BEARER_TOKEN_BEDROCK or standard AWS credentials/profile/role).
# @public
FACTORY_DEPLOYMENT_MODEL_PROVIDERS=

# AWS region for Amazon Bedrock. Falls back to AWS_DEFAULT_REGION, then us-east-1.
# @public
AWS_REGION=

# ---------------------------------------------------------------------------
# Authentication
# There is no default provider: the server refuses to start unless one of
# these is set (or the deployment passes its own provider to MastraFactory's
# `auth` option).
# ---------------------------------------------------------------------------

# Set to google for "Sign in with Google" on better-auth: every new person gets
# their own organization as its owner; others join an organization only by an
# invitation link an owner or admin copies from Settings › Organization. The
# session lives in an HttpOnly cookie in this server's database. `dev:local`
# sets it: Google sign-in is the only sign-in. A server on your own machine (a
# development server, NODE_ENV=development, or FACTORY_OWN_MACHINE=1) keeps its
# credential key in ~/.mastracode/factory-local-dev-key and offers Claude and
# ChatGPT sign-in and device preview; anywhere else set
# FACTORY_CREDENTIAL_ENCRYPTION_KEY. Needs MASTRACODE_PUBLIC_URL; register
# <MASTRACODE_PUBLIC_URL>/auth/api/callback/google as the client's redirect URI.
# @public @type=enum("", "google")
FACTORY_AUTH=
# Set to 1 when a production server (NODE_ENV=production, `start:local`) runs on
# your own machine: it keeps what a development server there has, on the same
# data: the local libSQL database without DATABASE_URL (MASTRA_DB_PATH), the
# machine credential key, Claude and ChatGPT sign-in and device preview. Needs
# FACTORY_AUTH=google. `start:local` sets it.
# @public @type=enum("", "1")
FACTORY_OWN_MACHINE=
# OAuth client id (Google Cloud › APIs & Services › Credentials › OAuth client
# ID, type "Web application"). Required with FACTORY_AUTH=google.
# @public
GOOGLE_CLIENT_ID=
# The secret of that OAuth client. Required with FACTORY_AUTH=google.
# @sensitive
GOOGLE_CLIENT_SECRET=
# Signs session cookies; at least 32 characters (`openssl rand -base64 32`).
# Changing it signs everyone out. Required with FACTORY_AUTH=google.
# @sensitive
FACTORY_AUTH_SECRET=
# Set to 1 to run with authentication disabled. API-only, for local smoke
# tests: user-scoped /web/* routes reject requests and the Factory web UI
# shows "no authentication provider configured", because the UI requires a
# sign-in provider.
# @public
MASTRACODE_AUTH_DISABLED=

# ---------------------------------------------------------------------------
# Notifications (@factory/notifications, ADR-0047)
# Email today (invitations to an organization). With nothing set, no email is
# sent and invitation links are shared by hand, as before.
# ---------------------------------------------------------------------------

# Channels to send through, comma-separated (`email`). Default: every channel
# that is configured.
# @public
FACTORY_NOTIFY_CHANNELS=
# The language of notifications for people whose language is unknown.
# @public @type=enum("", "en", "uk")
FACTORY_NOTIFY_LOCALE=
# Mail providers in the order of attempts, comma-separated: `smtp`, `log`
# (development: prints the message, sends nothing). Default: smtp when
# SMTP_HOST is set.
# @public
FACTORY_MAIL_PROVIDERS=
# The sender, `Name <address>`. Gmail sends only as the account's own address
# (or an alias set up in Gmail). Default: Factory <SMTP_USER>.
# @public
FACTORY_MAIL_FROM=
# SMTP server (Gmail: smtp.gmail.com, port 465, secure true, an app password).
# @public
SMTP_HOST=
# @public
SMTP_PORT=
# true: TLS from the first byte (465); false: STARTTLS (587). Default: true on 465.
# A plain string: varlock reads an enum("true", "false") value as a boolean and
# then refuses it, which stops the boot.
# @public
SMTP_SECURE=
# @public
SMTP_USER=
# The SMTP password (Gmail: an app password, not the account password).
# @sensitive
SMTP_PASS=

# ---------------------------------------------------------------------------
# Mastra Platform integrations
# PlatformGithubIntegration is a zero-argument integration. It uses a
# Platform credential: MASTRA_PLATFORM_ACCESS_TOKEN (checked first) or
# MASTRA_PLATFORM_SECRET_KEY.
# ---------------------------------------------------------------------------

# Credential Mastra Platform injects into deployed projects; locally set your
# platform org key here.
MASTRA_PLATFORM_ACCESS_TOKEN=
# Org secret key written by project scaffolding. Used by the Platform
# integrations when MASTRA_PLATFORM_ACCESS_TOKEN is unset.
MASTRA_PLATFORM_SECRET_KEY=
# Internal ownership markers written by `pnpm factory:dev`. They let setup
# rotate only the organization key created by this checkout.
FACTORY_PLATFORM_TOKEN_ID=
FACTORY_PLATFORM_TOKEN_ORGANIZATION_ID=
# Optional Integrations API endpoint override for Platform-backed integrations.
# @public @type=url
MASTRA_INTEGRATIONS_API_URL=
# Optional hosted Integrations API region. Unset uses the global endpoint.
# @public @type=enum("", "us", "eu")
MASTRA_PLATFORM_REGION=
# Optional Mastra project id, attributed on Platform integration proxy calls.
# @public
MASTRA_PROJECT_ID=
# GitHub event polling is enabled by default. Set false to disable it.
# (Bare true/false are listed alongside the quoted forms because varlock
# coerces unquoted booleans before enum validation.)
# @public @type=enum("", "true", "false", true, false)
MASTRA_PLATFORM_GITHUB_POLLING_ENABLED=
# Optional positive polling interval in milliseconds. Defaults to 5000.
# @public @type=string(matches="^(|[1-9][0-9]*)$")
MASTRA_PLATFORM_GITHUB_POLLING_INTERVAL_MS=
# Merged-PR reconcile sweep is enabled by default (runs even when event
# polling is disabled). Set false to disable it.
# @public @type=enum("", "true", "false", true, false)
MASTRA_PLATFORM_GITHUB_RECONCILE_ENABLED=

# ---------------------------------------------------------------------------
# Application database
# Optional Postgres database for Mastra agent state (threads, messages,
# memory, recall vectors) and Factory application data. When unset in local
# development, all Factory data uses a local libSQL file instead. To test with
# Postgres locally, run `pnpm db:up` from this package (`pnpm --dir
# mastracode/web db:up` from the monorepo root). The service uses
# postgres://user:pass@localhost:54329/mastracode_web.
# On the Mastra platform this is populated automatically by the managed
# env-var sync when a Neon (or other) database is attached to the project.
# ---------------------------------------------------------------------------

DATABASE_URL=
# Deprecated alias for DATABASE_URL. Honored as a fallback for existing
# checkouts; new setups should use DATABASE_URL instead.
APP_DATABASE_URL=

# Overrides the libSQL file path used when no database URL is set. Unset, the
# file resolves to the shared mastracode app-data directory — the same
# `mastra.db` the Mastra Code CLI opens, so running both at once yields
# `SQLITE_BUSY: database is locked`. Point this at a path inside the package to
# give the web dev server its own database.
MASTRA_DB_PATH=

# ---------------------------------------------------------------------------
# GitHub projects
# When all required GitHub App variables are set, signed-in users can install
# the GitHub App, pick repositories, and turn each repository into a project.
# Data uses local libSQL during local development or Postgres when DATABASE_URL
# is set.
#
# The GitHub callback URL is always derived from MASTRACODE_PUBLIC_URL
# (/auth/github/callback) — there is no separate redirect env var. Register
# this exact URL in both the GitHub App's "Callback URL" and "Setup URL"
# fields (Settings → GitHub Apps → your app → General).
# ---------------------------------------------------------------------------

# @public
GITHUB_APP_ID=
# PEM contents, e.g. "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# @required=not(isEmpty($GITHUB_APP_ID))
GITHUB_APP_PRIVATE_KEY=
# @public @required=not(isEmpty($GITHUB_APP_PRIVATE_KEY))
GITHUB_APP_CLIENT_ID=
# @required=not(isEmpty($GITHUB_APP_CLIENT_ID))
GITHUB_APP_CLIENT_SECRET=
# @public @required=not(isEmpty($GITHUB_APP_CLIENT_SECRET))
GITHUB_APP_SLUG=
# Stable secret for signing GitHub OAuth/install state and verifying webhooks.
# A configured GitHub integration requires this value, even when webhooks
# are disabled. Slack falls back to
# SLACK_APP_SIGNING_SECRET when neither is set, so a Slack-only deployment
# boots without a GitHub App.
GITHUB_APP_WEBHOOK_SECRET=
# Optional fallback token (ADR-0034). Organizations connect GitHub in
# Settings › Підключення › Додати підключення: through the GitHub App above
# (offered only when the GITHUB_APP_* group is set) or with a personal access
# token an org admin pastes there, stored encrypted for the org. That is the
# main path; no env var is needed for it.
# This token only serves the connections the former server-wide token mode
# registered (installation rows keyed by this token's account id) until an
# admin replaces their token in Settings. It may be set together with the
# GITHUB_APP_* group. Scopes: classic `repo`, or fine-grained Contents, Issues,
# Pull requests and Commit statuses read/write (Workflows if agents edit CI).
# Token connections get no webhooks: issues and pull requests are polled every
# 2 minutes unless MASTRACODE_GITHUB_RECONCILE_INTERVAL_MS is set.
# With a person's own token Factory writes as that person.
GITHUB_ACCESS_TOKEN=
# No longer read (ADR-0034): each organization connects its own tokens, so
# nothing claims GITHUB_ACCESS_TOKEN for one org. Delete it from the env.
# @public
GITHUB_ACCESS_TOKEN_ORG_ID=
# The status comment Factory keeps on a pull request while it reviews it.
# How the comment names the reviewer. Empty: Factory.
# @public
FACTORY_REVIEW_STATUS_NAME=
# Serve the "Reviewing…" animation from your own host. Empty: the light and
# dark GIFs in the mastra-ai/mastra repository. A self-hosted image is never
# paired with the built-in dark variant; set the dark URL to add one.
# @public
FACTORY_REVIEW_STATUS_GIF_URL=
# @public
FACTORY_REVIEW_STATUS_GIF_DARK_URL=
# Merged-PR reconcile sweep is enabled by default. It is the only writer of
# merge state when GitHub cannot reach this deployment's webhook endpoint
# (private network, local dev). Set false to disable it.
# (Bare true/false are listed alongside the quoted forms because varlock
# coerces unquoted booleans before enum validation.)
# @public @type=enum("", "true", "false", true, false)
MASTRACODE_GITHUB_RECONCILE_ENABLED=
# Optional positive sweep interval in milliseconds. Defaults to 300000 (5min).
# @public @type=string(matches="^(|[1-9][0-9]*)$")
MASTRACODE_GITHUB_RECONCILE_INTERVAL_MS=

# ---------------------------------------------------------------------------
# GitLab intake and source control
# Choose one mode:
# - Direct: paste a Personal or Group Access Token into GITLAB_ACCESS_TOKEN.
#   Use scopes `api` and `write_repository`; Group Access Tokens are limited to
#   their group and require the relevant GitLab subscription on GitLab.com.
# - Mastra Platform/Nango: nothing to set. Platform credentials discover every
#   active GitLab connection and route requests through
#   /v2/connections/{connectionId}/proxy, and Factory polls the Platform event
#   log for GitLab events, so the GitLab project webhook points at the
#   Platform's Nango forwarding URL, not at Factory. Platform mode needs
#   neither MASTRA_GITLAB_CONNECTION_ID (optional, pins discovery to one
#   connection) nor MASTRA_GITLAB_WEBHOOK_SECRET.
# An explicit direct token takes precedence over Platform auto-registration.
# ---------------------------------------------------------------------------

GITLAB_ACCESS_TOKEN=
# @public @type=enum("", "personal", "group")
GITLAB_ACCESS_TOKEN_TYPE=personal
# @public
GITLAB_BASE_URL=https://gitlab.com
GITLAB_WEBHOOK_SECRET=
# Optional filter restricting the Platform integration to one connection.
# @public
MASTRA_GITLAB_CONNECTION_ID=
# Optional. Only needed for a direct project webhook to /web/gitlab/webhook.
MASTRA_GITLAB_WEBHOOK_SECRET=
# GitLab event polling is enabled by default in Platform mode. Set false to
# disable it. (Bare true/false are listed alongside the quoted forms because
# varlock coerces unquoted booleans before enum validation.)
# @public @type=enum("", "true", "false", true, false)
MASTRA_PLATFORM_GITLAB_POLLING_ENABLED=
# Optional positive polling interval in milliseconds. Defaults to 20000.
# @public @type=string(matches="^(|[1-9][0-9]*)$")
MASTRA_PLATFORM_GITLAB_POLLING_INTERVAL_MS=

# ---------------------------------------------------------------------------
# ClickUp intake (polling, no webhook)
# No token here: each organization's admin connects its ClickUp personal API
# token in Settings › Connections › ClickUp, stored encrypted per organization
# (docs/adr/0032). A CLICKUP_API_TOKEN left over from older versions is moved
# into the `factory-local-org` organization once, at the first boot of this
# version, and never read again: delete it afterwards.
# ---------------------------------------------------------------------------

# Seconds between ClickUp sweeps. Minimum 15, default 60.
# @public @type=string(matches="^(|[1-9][0-9]*)$")
CLICKUP_POLL_INTERVAL_SECONDS=

# ---------------------------------------------------------------------------
# Model providers
# API keys for the agent's model providers. Loaded from this file by the
# code SDK on boot; keys can also be added/managed at runtime from the
# web UI (Settings › Models). At least one provider key (or a stored
# credential) is needed for agents to run.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Distributed event bus (optional)
# When set, events (streams, workflows, signals) ride Redis Streams so
# multiple web server processes share one event bus. Unset for single-process
# local dev. docker-compose.yml provides redis://localhost:63799.
# ---------------------------------------------------------------------------

REDIS_URL=

# ---------------------------------------------------------------------------
# Sandbox provider (repo materialization)
# GitHub-backed projects are materialized (cloned) into a sandbox on open. The
# only provider is LOCAL: it runs git and agent commands directly on the
# server host. The host must have `git` and `gh` (the GitHub CLI) and outbound
# access to github.com; `gh` is only needed to open pull requests.
#
# WARNING: the local provider has NO tenant isolation — every project's git
# runs as the server process on the shared host filesystem. It is intended for
# single-user deployments.
# ---------------------------------------------------------------------------

# Host root for LocalSandbox checkouts (default ~/.mastracode/web/sandboxes);
# only used by the local provider.
# @public
MASTRACODE_LOCAL_SANDBOX_ROOT=
# Per-replica cap on concurrently live sandboxes. New provisioning beyond this
# returns an actionable error; 0 / unset means unlimited.
# @public @type=string(matches="^(|[0-9]+)$")
MASTRACODE_MAX_SANDBOXES=

# ---------------------------------------------------------------------------
# Multi-replica deployment
# ---------------------------------------------------------------------------

# Set to 0 to disable the Postgres advisory-lock layer used to serialize
# per-(project,user) git write operations across replicas. When enabled
# (default), it requires DATABASE_URL. Use 0 for single-process local dev.
# @public @type=enum("", "0", "1")
MASTRACODE_DISTRIBUTED_LOCK=

# ---------------------------------------------------------------------------
# Local development tools
# ---------------------------------------------------------------------------

# Set to exactly "true" to load react-grab in the Vite development server;
# empty means off.
# @public @type=enum("", "true")
VITE_REACT_GRAB=

# The `claude` CLI that Claude Code Factories run. Unset: the server finds `claude` itself, on PATH
# and then where it installs (~/.local/bin, ~/.claude/local, the server's and nvm's node bin,
# /opt/homebrew/bin, /usr/local/bin; ADR-0038), and logs the path and version at boot. Set it to
# an absolute path to pin one; only that path is then used.
# @public
FACTORY_CLAUDE_CODE_COMMAND=

# The `codex` CLI that Codex Factories run; found as `claude` is when unset (ADR-0038).
# @public
FACTORY_CODEX_COMMAND=

# Agents as a separate macOS user (ADR-0041, scripts/mac-mini/isolation). Unset: agents run as
# this server's user, as before. Set (e.g. "factory"): Claude Code turns run as that user through
# sudo under the root-owned Seatbelt profile; FACTORY_CLAUDE_CODE_COMMAND is then not used.
# @public
FACTORY_AGENT_USER=

# The agent user's home; /Users/<user> when unset.
# @public
FACTORY_AGENT_HOME=

# The Seatbelt profile agent commands run under; /var/factory/agent-<user>.sb when unset.
# @public
FACTORY_AGENT_PROFILE=

# More folders the agent may write, ":"-separated, besides MASTRACODE_LOCAL_SANDBOX_ROOT.
# @public
FACTORY_AGENT_WRITABLE=

# The agent's PATH for its tools, ":"-separated; <home>/.local/bin:<home>/.local/node/bin when unset.
# @public
FACTORY_AGENT_PATH=

# Where the server puts turn files the agent reads (config dirs, MCP config); <sandboxes>/.agent-state when unset.
# @public
FACTORY_AGENT_STATE_DIR=

# The agent's own `claude` to run; `claude` on its PATH when unset.
# @public
FACTORY_AGENT_CLAUDE_COMMAND=

# The agent's own `codex` to run; `codex` on its PATH when unset.
# @public
FACTORY_AGENT_CODEX_COMMAND=

# The root-owned xcconfig xcodebuild applies under the Seatbelt profile (2-system.sh agent-xcode);
# /var/factory/agent-<user>.xcconfig when unset. Whether a Factory's agents run under Seatbelt is
# its sandbox setting (Settings › Environment › Sandbox › Agent isolation), not a variable:
# FACTORY_AGENT_SEATBELT was removed and stops the boot when set.
# @public
FACTORY_AGENT_XCODE_CONFIG=

# Agent processes no turn owns (daemons, `nohup ... &`, turns of a server that restarted) are killed as the
# agent user: at start, then every minute (10 minutes' grace while no turn runs, 6 hours at most). on (default) or off.
# @public
FACTORY_AGENT_REAP=
