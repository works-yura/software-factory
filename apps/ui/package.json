    "@mastra/react": "1.12.0",
    "@nangohq/frontend": "0.71.6",
    "@pierre/diffs": "1.5.1",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.10.2",
    "d3-force": "3.0.0",
    "date-fns": "4.4.0",
