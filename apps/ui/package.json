{
  "name": "@factory/app-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Factory web UI (React, Vite).",
  "scripts": {
    "dev": "node ../../packages/playground-ui/scripts/ensure-built.mjs && MASTRACODE_ENV_DIR=../server vite --config src/vite.config.ts",
    "build": "node ../../packages/playground-ui/scripts/ensure-built.mjs && vite --config src/vite.config.ts build",
    "typecheck": "node ../../packages/playground-ui/scripts/ensure-built.mjs && tsc --noEmit -p src/ui/tsconfig.json",
    "test": "node ../../packages/playground-ui/scripts/ensure-built.mjs && node ../../scripts/vitest-isolate-failures.mjs",
    "test:unit": "node ../../packages/playground-ui/scripts/ensure-built.mjs && vitest run --project unit:factory-ui",
    "test:msw": "node ../../packages/playground-ui/scripts/ensure-built.mjs && vitest run --project msw:factory-ui",
    "check": "node ../../packages/playground-ui/scripts/ensure-built.mjs && tsc --noEmit -p src/ui/tsconfig.json"
  },
  "dependencies": {
    "@factory/api": "workspace:*",
